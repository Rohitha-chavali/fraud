# Fraud Shield AI - Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEMO_MODE=True

# Database (Leave as is for automatic local embedded DB fallback, or provide MongoDB URI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fraud_shield_ai

# Gemini AI (Optional - Platform provides built-in fallback Lumora intelligence if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
